<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KorkiPL</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <header>
        <nav>
            <a class="logo" asp-controller="Home" asp-action="Index">KorkiPL</a>



            <ul>
                <li><a asp-controller="Home" asp-action="Index">Strona główna</a></li>
                <li><a asp-controller="Ogloszenia" asp-action="Index">Ogłoszenia</a></li>

                @if (User.Identity!.IsAuthenticated)
                {
                <li><a asp-controller="Ogloszenia" asp-action="Moje">Moje ogłoszenia</a></li>
                <li><a asp-controller="Ogloszenia" asp-action="Dodaj">+ Dodaj</a></li>
                <li class="user-info">Zalogowany: @User.Identity.Name</li>
                <li><a asp-controller="Konto" asp-action="Wyloguj">Wyloguj</a></li>
                }
                else
                {
                <li><a asp-controller="Konto" asp-action="Logowanie">Zaloguj</a></li>
                <li><a asp-controller="Konto" asp-action="Rejestracja">Zarejestruj</a></li>
                }
            </ul>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year KorkiPL</p>
    </footer>
</body>
</html>
