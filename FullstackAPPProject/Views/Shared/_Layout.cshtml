@inject FullstackAPPProject.Data.AppDbContext Db
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KorkiPL</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    @* Liczymy nieprzeczytane wiadomości dla zalogowanego usera - prosto, bezpośrednio z DbContext *@
    @{
        int nieprzeczytaneWiadomosci = 0;
        if (User.Identity!.IsAuthenticated)
        {
            var idText = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idText, out int mojeId))
            {
                nieprzeczytaneWiadomosci = Db.Wiadomosci.Count(w => w.OdbiorcaId == mojeId && !w.Przeczytana);
            }
        }
    }
    <header>
        <nav>
            <a class="logo" asp-controller="Home" asp-action="Index"><i class="bi bi-book"></i> KorkiPL</a>

            <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
                <i class="bi bi-list"></i>
            </button>

            <ul id="navMenu">
                <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Strona główna</a></li>
                <li><a asp-controller="Ogloszenia" asp-action="Index"><i class="bi bi-search"></i> Ogłoszenia</a></li>

                @if (User.Identity!.IsAuthenticated)
                {
                    @* --- KOREPETYTOR: widzi swoje ogłoszenia i może dodawać --- *@
                    @if (User.IsInRole("Korepetytor"))
                    {
                        <li><a asp-controller="Ogloszenia" asp-action="Moje"><i class="bi bi-collection"></i> Moje ogłoszenia</a></li>
                        <li><a asp-controller="Ogloszenia" asp-action="Dodaj"><i class="bi bi-plus-circle"></i> Dodaj</a></li>
                    }

                        @* --- PANEL: dla każdej roli --- *@
                        @if (!User.IsInRole("Uczen"))
                        {
                        <li><a asp-controller="Konto" asp-action="Panel"><i class="bi bi-speedometer2"></i> Panel</a></li>
                        }

                      

                    @* --- WIADOMOŚCI z licznikiem --- *@
                    <li>
                        <a asp-controller="Wiadomosci" asp-action="Index">
                            <i class="bi bi-chat-dots"></i> Wiadomości
                            @if (nieprzeczytaneWiadomosci > 0)
                            {
                                <span class="nav-licznik">@nieprzeczytaneWiadomosci</span>
                            }
                        </a>
                    </li>

                    @* --- DROPDOWN UŻYTKOWNIKA --- *@
                    <li class="user-dropdown">
                        <button class="user-dropdown-btn" id="userDropdownBtn">
                            <i class="bi bi-person-circle"></i> @User.Identity.Name
                            <i class="bi bi-chevron-down" style="font-size: 10px;"></i>
                        </button>
                        <div class="user-dropdown-menu" id="userDropdownMenu">
                            <a asp-controller="Konto" asp-action="Profil" asp-route-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
                                <i class="bi bi-person"></i> Mój profil
                            </a>
                            <a asp-controller="Konto" asp-action="EdytujProfil">
                                <i class="bi bi-pencil-square"></i> Edytuj profil
                            </a>
                            @if (!User.IsInRole("Uczen"))
                                {
                                <a asp-controller="Konto" asp-action="Panel">
                                    <i class="bi bi-speedometer2"></i> Panel
                                </a>
                                }

                            <div class="user-dropdown-divider"></div>
                            <a asp-controller="Konto" asp-action="Wyloguj" style="color: #dc2626;">
                                <i class="bi bi-box-arrow-right"></i> Wyloguj
                            </a>
                        </div>
                    </li>
                }
                else
                {
                    <li><a asp-controller="Konto" asp-action="Logowanie"><i class="bi bi-box-arrow-in-right"></i> Zaloguj</a></li>
                    <li><a asp-controller="Konto" asp-action="Rejestracja"><i class="bi bi-person-plus"></i> Zarejestruj</a></li>
                }
            </ul>
        </nav>
    </header>
  


    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year KorkiPL &mdash; Platforma korepetycji</p>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
