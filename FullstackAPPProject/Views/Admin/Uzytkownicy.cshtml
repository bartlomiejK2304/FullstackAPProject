@model List<Uzytkownik>
@{
    ViewData["Title"] = "Zarządzanie użytkownikami";
}
 
<p><a asp-action="Index"><i class="bi bi-arrow-left"></i> Wróć do panelu admina</a></p>
 
<h1><i class="bi bi-people"></i> Użytkownicy (@Model.Count)</h1>
 
@if (TempData["Blad"] != null)
{
    <div class="blad"><i class="bi bi-exclamation-triangle"></i> @TempData["Blad"]</div>
}
@if (TempData["Sukces"] != null)
{
    <div class="info-pasek" style="background: #dcfce7; border-color: #86efac; color: #166534;">
        <i class="bi bi-check-circle"></i> @TempData["Sukces"]
    </div>
}
 
<table class="admin-tabela">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nazwa</th>
            <th>Rola</th>
            <th>Opis</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Id</td>
                <td>
                    <a asp-controller="Konto" asp-action="Profil" asp-route-id="@u.Id">
                        <strong>@u.Nazwa</strong>
                    </a>
                </td>
                <td><span class="badge-rola">@u.Rola</span></td>
                <td>@(u.Opis != null ? (u.Opis.Length > 50 ? u.Opis.Substring(0, 50) + "..." : u.Opis) : "—")</td>
                <td>
                    @if (u.Rola != "Admin")
                    {
                        <form asp-action="UsunUzytkownika" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@u.Id" />
                            <button type="submit" class="button-czerwony" style="padding: 6px 12px; font-size: 13px;"
                                    onclick="return confirm('Na pewno usunąć użytkownika @u.Nazwa? Zostaną usunięte też jego ogłoszenia, wiadomości i opinie.');">
                                <i class="bi bi-trash"></i> Usuń
                            </button>
                        </form>
                    }
                    else
                    {
                        <span style="color: var(--kolor-tekst-szary); font-size: 13px;">Administrator</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
