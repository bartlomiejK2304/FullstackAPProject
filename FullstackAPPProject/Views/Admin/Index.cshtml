@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.HeadTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.BodyTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@inject FullstackAPPProject.Data.AppDbContext Db
@{
    ViewData["Title"] = "Panel administracyjny";
    Layout = null;

    int liczbaUzytkownikow = ViewBag.LiczbaUzytkownikow;
    int liczbaOgloszen = ViewBag.LiczbaOgloszen;
    int liczbaKategorii = ViewBag.LiczbaKategorii;
    int liczbaWiadomosci = ViewBag.LiczbaWiadomosci;
    int liczbaOpinii = ViewBag.LiczbaOpinii;
    int liczbaUsuniec = ViewBag.LiczbaUsuniec;

    int liczbaKorepetytorow = Db.Uzytkownicy.Count(u => u.Rola == "Korepetytor");
    int liczbaUczniow = Db.Uzytkownicy.Count(u => u.Rola == "Uczen");
    decimal sredniaCena = Db.Ogloszenia.Any() ? (decimal)Db.Ogloszenia.Select(o => (double)o.Cena).Average() : 0;
    double sredniaOcena = Db.Opinie.Any() ? Db.Opinie.Average(o => (double)o.Ocena) : 0;

    var ostatnieOgloszenia = Db.Ogloszenia
        .OrderByDescending(o => o.DataDodania).Take(5)
        .Select(o => new { o.Id, o.Tytul, o.Cena, o.DataDodania, Autor = o.Uzytkownik!.Nazwa, Kategoria = o.Kategoria!.Nazwa })
        .ToList();

    var ostatniUzytkownicy = Db.Uzytkownicy.OrderByDescending(u => u.Id).Take(5).ToList();

    var kategorieStats = Db.Kategorie
        .Select(k => new { k.Nazwa, Ilosc = k.Ogloszenia.Count })
        .OrderByDescending(k => k.Ilosc).ToList();

    var topKorepetytorzy = Db.Uzytkownicy
        .Where(u => u.Rola == "Korepetytor")
        .Select(u => new
        {
            u.Id,
            u.Nazwa,
            LiczbaOgloszen = u.Ogloszenia.Count,
            LiczbaOpinii = Db.Opinie.Count(o => o.KorepetytorId == u.Id),
            Srednia = Db.Opinie.Where(o => o.KorepetytorId == u.Id).Any()
                ? Db.Opinie.Where(o => o.KorepetytorId == u.Id).Average(o => (double)o.Ocena) : 0
        })
        .OrderByDescending(u => u.Srednia).ThenByDescending(u => u.LiczbaOgloszen)
        .Take(5).ToList();

    var ostatnieOpinie = Db.Opinie
        .OrderByDescending(o => o.DataDodania).Take(3)
        .Select(o => new { o.Ocena, o.Tresc, o.DataDodania, Autor = o.Autor!.Nazwa, Korepetytor = o.Korepetytor!.Nazwa })
        .ToList();
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - KorkiPL</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --sb-bg: #1e293b;
                --sb-hover: #334155;
                --sb-active: #475569;
                --card: #ffffff;
                --accent: #475569;
                --page: #f1f5f9;
                --text: #1e293b;
                --gray: #64748b;
                --border: #e2e8f0;
                --green: #22c55e;
                --amber: #f59e0b;
                --red: #ef4444;
                --blue: #3b82f6;
                --font: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font);
                background: var(--page);
                color: var(--text);
                display: flex;
                min-height: 100vh;
            }

            /* SIDEBAR */
            .sb {
                width: 240px;
                background: var(--sb-bg);
                color: #fff;
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                overflow-y: auto;
                z-index: 100;
            }

            .sb-logo {
                padding: 20px;
                font-size: 18px;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 8px;
                border-bottom: 1px solid rgba(255,255,255,.06);
                text-decoration: none;
                color: #fff;
            }

                .sb-logo i {
                    color: var(--accent);
                }

            .sb-sect {
                padding: 18px 16px 6px;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                color: rgba(255,255,255,.3);
            }

            .sb a:not(.sb-logo) {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 16px;
                margin: 1px 8px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                color: rgba(255,255,255,.6);
                text-decoration: none;
                transition: .12s;
            }

                .sb a:not(.sb-logo):hover {
                    background: var(--sb-hover);
                    color: #fff;
                }

            .sb a.act {
                background: var(--accent);
                color: #fff;
            }

            .sb a i {
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .sb-badge {
                margin-left: auto;
                background: rgba(255,255,255,.15);
                font-size: 11px;
                font-weight: 700;
                padding: 1px 7px;
                border-radius: 99px;
            }

            .sb-foot {
                margin-top: auto;
                padding: 14px 16px;
                border-top: 1px solid rgba(255,255,255,.06);
                display: flex;
                flex-direction: column;
            }

            /* MAIN */
            .mn {
                margin-left: 240px;
                flex: 1;
                padding: 24px 28px;
            }

            /* WELCOME BANNER */
            .welcome {
                background: #334155;
                border-radius: 14px;
                padding: 28px 32px;
                color: #fff;
                margin-bottom: 24px;
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                flex-wrap: wrap;
                gap: 20px;
            }

                .welcome h1 {
                    font-size: 24px;
                    font-weight: 800;
                    margin-bottom: 4px;
                }

                .welcome p {
                    opacity: .85;
                    font-size: 14px;
                    margin-bottom: 16px;
                }

            .welcome-links {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
            }

                .welcome-links a {
                    display: inline-flex;
                    align-items: center;
                    gap: 5px;
                    padding: 7px 14px;
                    background: rgba(255,255,255,.12);
                    color: #fff;
                    border-radius: 6px;
                    font-size: 13px;
                    font-weight: 600;
                    text-decoration: none;
                    transition: .12s;
                }

                    .welcome-links a:hover {
                        background: rgba(255,255,255,.3);
                    }

            .welcome-date {
                font-size: 13px;
                opacity: .7;
                padding: 8px 14px;
                background: rgba(0,0,0,.15);
                border-radius: 8px;
                white-space: nowrap;
            }

            /* GRID */
            .g2 {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
                margin-bottom: 20px;
            }

            .g3 {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 20px;
                margin-bottom: 20px;
            }

            .g23 {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 20px;
                margin-bottom: 20px;
            }

            /* CARD */
            .cd {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 20px;
            }

            .cd-title {
                font-size: 14px;
                font-weight: 700;
                color: var(--gray);
                margin-bottom: 14px;
                display: flex;
                align-items: center;
                gap: 6px;
                text-transform: uppercase;
                letter-spacing: .3px;
            }

                .cd-title i {
                    color: var(--accent);
                    font-size: 16px;
                }

            /* STAT MINI */
            .st {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .st-ico {
                width: 44px;
                height: 44px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                flex-shrink: 0;
            }

            .st-num {
                font-size: 22px;
                font-weight: 800;
                line-height: 1;
            }

            .st-lbl {
                font-size: 12px;
                color: var(--gray);
                margin-top: 2px;
            }

            /* TABLE */
            .tb {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .tb th {
                    text-align: left;
                    padding: 8px 10px;
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                    color: var(--gray);
                    border-bottom: 2px solid var(--border);
                    font-weight: 700;
                }

                .tb td {
                    padding: 9px 10px;
                    border-bottom: 1px solid #f1f5f9;
                }

                .tb tr:last-child td {
                    border-bottom: none;
                }

                .tb a {
                    color: var(--accent);
                    text-decoration: none;
                    font-weight: 600;
                }

            /* BAR */
            .bar-row {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 8px;
            }

            .bar-lbl {
                width: 100px;
                font-size: 12px;
                font-weight: 600;
                text-align: right;
                flex-shrink: 0;
                color: var(--text);
            }

            .bar-track {
                flex: 1;
                height: 24px;
                background: #f1f5f9;
                border-radius: 6px;
                overflow: hidden;
            }

            .bar-fill {
                height: 100%;
                border-radius: 6px;
                display: flex;
                align-items: center;
                padding-left: 8px;
                color: #fff;
                font-size: 11px;
                font-weight: 700;
                min-width: 24px;
                background: #475569;
            }

            /* USER ROW */
            .ur {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 7px 0;
                border-bottom: 1px solid #f1f5f9;
            }

                .ur:last-child {
                    border-bottom: none;
                }

            .ur-av {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #475569;
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 13px;
                flex-shrink: 0;
            }

            .ur-name {
                font-weight: 600;
                font-size: 13px;
            }

            .ur-sub {
                font-size: 11px;
                color: var(--gray);
            }

            /* BADGE */
            .bg {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 99px;
                font-size: 10px;
                font-weight: 700;
            }

            .bg-p {
                background: #f3f4f6;
                color: #4b5563;
            }

            .bg-b {
                background: #dbeafe;
                color: #2563eb;
            }

            .bg-r {
                background: #fee2e2;
                color: #dc2626;
            }

            .bg-g {
                background: #dcfce7;
                color: #16a34a;
            }

            /* REVIEW */
            .rv {
                padding: 10px 0;
                border-bottom: 1px solid #f1f5f9;
            }

                .rv:last-child {
                    border-bottom: none;
                }

            .rv-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 4px;
            }

            .rv-stars {
                color: var(--amber);
                font-size: 13px;
            }

            .rv-text {
                font-size: 13px;
                color: var(--text);
                line-height: 1.4;
            }

            .rv-meta {
                font-size: 11px;
                color: var(--gray);
                margin-top: 3px;
            }

            /* BTN */
            .btn {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 7px 14px;
                background: var(--accent);
                color: #fff;
                border: none;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                font-family: var(--font);
            }

                .btn:hover {
                    background: #374151;
                    color: #fff;
                }

            @@media (max-width: 1100px) {
                .g3 {
                    grid-template-columns: 1fr 1fr;
                }

                .g23 {
                    grid-template-columns: 1fr;
                }
            }

            @@media (max-width: 768px) {
                .sb {
                    display: none;
                }

                .mn {
                    margin-left: 0;
                    padding: 16px;
                }

                .g2, .g3 {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>

    <aside class="sb">
        <a class="sb-logo" asp-controller="Home" asp-action="Index"><i class="bi bi-book"></i> KorkiPL</a>
        <div class="sb-sect">Nawigacja</div>
        <a href="#" class="act"><i class="bi bi-grid-1x2"></i> Kokpit</a>
        <div class="sb-sect">Zarządzanie</div>
        <a asp-action="Uzytkownicy"><i class="bi bi-people"></i> Użytkownicy <span class="sb-badge">@liczbaUzytkownikow</span></a>
        <a asp-action="Ogloszenia"><i class="bi bi-collection"></i> Ogłoszenia <span class="sb-badge">@liczbaOgloszen</span></a>
        <a asp-action="Kategorie"><i class="bi bi-tags"></i> Kategorie <span class="sb-badge">@liczbaKategorii</span></a>
        <div class="sb-sect">Raporty</div>
        <a asp-action="UsunieciaKont">
            <i class="bi bi-person-x"></i> Usunięte konta
            @if (liczbaUsuniec > 0)
            {
                <span class="sb-badge" style="background:rgba(220,38,38,.15);color:#fca5a5;">@liczbaUsuniec</span>
            }
        </a>
        <div class="sb-foot">
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Wróć na stronę</a>
            <a asp-controller="Konto" asp-action="Wyloguj"><i class="bi bi-box-arrow-right"></i> Wyloguj</a>
        </div>
    </aside>

    <div class="mn">

        <!-- WELCOME -->
        <div class="welcome">
            <div>
                <h1>Witaj w panelu administracyjnym!</h1>
                <p>Zarządzaj użytkownikami, ogłoszeniami i treściami serwisu KorkiPL.</p>
                <div class="welcome-links">
                    <a asp-action="Uzytkownicy"><i class="bi bi-people"></i> Użytkownicy</a>
                    <a asp-action="Ogloszenia"><i class="bi bi-collection"></i> Ogłoszenia</a>
                    <a asp-action="Kategorie"><i class="bi bi-tags"></i> Kategorie</a>
                    <a asp-controller="Home" asp-action="Index"><i class="bi bi-eye"></i> Zobacz stronę</a>
                </div>
            </div>
            <div class="welcome-date">
                <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("pl-PL"))
            </div>
        </div>

        <!-- STAT ROW 1 -->
        <div class="g3">
            <div class="cd">
                <div class="st">
                    <div class="st-ico" style="background:#eff6ff;color:var(--blue);"><i class="bi bi-people-fill"></i></div>
                    <div><div class="st-num">@liczbaUzytkownikow</div><div class="st-lbl">Użytkowników</div></div>
                </div>
                <div style="display:flex;gap:12px;margin-top:12px;">
                    <div style="font-size:12px;"><span style="color:var(--accent);font-weight:700;">@liczbaKorepetytorow</span> korepetytorów</div>
                    <div style="font-size:12px;"><span style="color:var(--blue);font-weight:700;">@liczbaUczniow</span> uczniów</div>
                </div>
            </div>
            <div class="cd">
                <div class="st">
                    <div class="st-ico" style="background:#f9fafb;color:var(--accent);"><i class="bi bi-collection-fill"></i></div>
                    <div><div class="st-num">@liczbaOgloszen</div><div class="st-lbl">Ogłoszeń</div></div>
                </div>
                <div style="font-size:12px;margin-top:12px;"><span style="color:var(--green);font-weight:700;">@sredniaCena.ToString("0") zł</span> średnia cena / godz.</div>
            </div>
            <div class="cd">
                <div class="st">
                    <div class="st-ico" style="background:#fffbeb;color:var(--amber);"><i class="bi bi-star-fill"></i></div>
                    <div><div class="st-num">@sredniaOcena.ToString("0.0")</div><div class="st-lbl">Średnia ocena</div></div>
                </div>
                <div style="font-size:12px;margin-top:12px;">
                    <span style="font-weight:700;">@liczbaOpinii</span> opinii ·
                    <span style="font-weight:700;">@liczbaWiadomosci</span> wiadomości
                </div>
            </div>
        </div>

        <!-- MAIN GRID -->
        <div class="g23">
            <!-- LEFT: Tabela ogłoszeń -->
            <div class="cd">
                <div class="cd-title"><i class="bi bi-clock-history"></i> Ostatnie ogłoszenia</div>
                <table class="tb">
                    <thead><tr><th>Tytuł</th><th>Autor</th><th>Kategoria</th><th>Cena</th><th>Data</th></tr></thead>
                    <tbody>
                        @foreach (var o in ostatnieOgloszenia)
                        {
                            <tr>
                                <td><a asp-controller="Ogloszenia" asp-action="Szczegoly" asp-route-id="@o.Id">@(o.Tytul.Length > 35 ? o.Tytul.Substring(0, 35) + "…" : o.Tytul)</a></td>
                                <td>@o.Autor</td>
                                <td><span class="bg bg-p">@o.Kategoria</span></td>
                                <td style="font-weight:700;">@o.Cena zł</td>
                                <td style="color:var(--gray);">@o.DataDodania.ToString("dd.MM")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a asp-action="Ogloszenia" class="btn" style="width:100%;justify-content:center;margin-top:14px;">
                    Zarządzaj ogłoszeniami <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <!-- RIGHT: Ostatnie opinie -->
            <div class="cd">
                <div class="cd-title"><i class="bi bi-chat-quote"></i> Ostatnie opinie</div>
                @if (!ostatnieOpinie.Any())
                {
                    <p style="color:var(--gray);font-size:13px;">Brak opinii.</p>
                }
                @foreach (var op in ostatnieOpinie)
                {
                    <div class="rv">
                        <div class="rv-top">
                            <strong style="font-size:13px;">@op.Autor → @op.Korepetytor</strong>
                            <div class="rv-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= op.Ocena)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-star" style="color:#d4d4d8;"></i>
                                    }
                                }
                            </div>
                        </div>
                        <div class="rv-text">@(op.Tresc.Length > 80 ? op.Tresc.Substring(0, 80) + "…" : op.Tresc)</div>
                        <div class="rv-meta">@op.DataDodania.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            </div>
        </div>

        <!-- BOTTOM GRID -->
        <div class="g23">
            <!-- LEFT: Wykres kategorii -->
            <div class="cd">
                <div class="cd-title"><i class="bi bi-bar-chart"></i> Ogłoszenia według kategorii</div>
                @{
                    int maxI = kategorieStats.Any() ? kategorieStats.Max(k => k.Ilosc) : 1; if (maxI == 0) maxI = 1;
                }
                @foreach (var k in kategorieStats)
                {
                    double p = (double)k.Ilosc / maxI * 100;
                    <div class="bar-row">
                        <div class="bar-lbl">@k.Nazwa</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width:@p.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">@k.Ilosc</div>
                        </div>
                    </div>
                }
            </div>

            <!-- RIGHT: Użytkownicy + ranking -->
            <div class="cd">
                <div class="cd-title"><i class="bi bi-trophy"></i> Top korepetytorzy</div>
                @{
                    int poz = 1;
                }
                @foreach (var k in topKorepetytorzy)
                {
                    <div class="ur">
                        <div style="width:22px;font-size:13px;font-weight:800;color:@(poz == 1 ? "#b45309" : poz == 2 ? "#64748b" : "#c2410c");text-align:center;">@poz</div>
                        <div class="ur-av">@(k.Nazwa[0].ToString().ToUpper())</div>
                        <div style="flex:1;">
                            <div class="ur-name">@k.Nazwa</div>
                            <div class="ur-sub">@k.LiczbaOgloszen ogł. · @k.LiczbaOpinii opinii</div>
                        </div>
                        @if (k.Srednia > 0)
                        {
                            <span style="font-weight:800;color:var(--amber);font-size:13px;">@k.Srednia.ToString("0.0") ★</span>
                        }
                    </div>
                    poz++;
                }
                <a asp-action="Uzytkownicy" class="btn" style="width:100%;justify-content:center;margin-top:14px;">
                    Zarządzaj użytkownikami <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

    </div>
</body>
</html>
