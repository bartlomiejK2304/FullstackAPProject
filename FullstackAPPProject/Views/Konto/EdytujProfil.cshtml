@model Uzytkownik
@{
    ViewData["Title"] = "Edytuj profil";
}
 
<h1><i class="bi bi-pencil"></i> Edytuj profil</h1>
 
<div class="formularz-karta">
    @if (ViewBag.Blad != null)
    {
        <div class="blad"><i class="bi bi-exclamation-triangle"></i> @ViewBag.Blad</div>
    }
 
    <form method="post" asp-action="EdytujProfil" enctype="multipart/form-data">
 
        <div class="pole">
            <label><i class="bi bi-image"></i> Zdjêcie profilowe</label>
 
            <div style="margin-bottom: 12px;">
                @{
                    var vdAvatarEdyt = new ViewDataDictionary(ViewData) { { "Rozmiar", "duzy" } };
                }
                @await Html.PartialAsync("partial _Avatar", Model, vdAvatarEdyt)
            </div>
 
            <input type="file" name="zdjecieProfil" accept="image/*" />
            <small style="color: var(--kolor-tekst-szary); font-size: 13px;">
                Wybierz nowe zdjêcie ¿eby zamieniæ aktualne. Zostaw puste ¿eby nic nie zmieniaæ.
            </small>
        </div>
 
        @if (!User.IsInRole("Uczen"))
        {
            <div class="pole">
                <label for="opis">O mnie</label>
                <textarea name="opis" id="opis" rows="5" maxlength="500"
                          placeholder="Napisz parê s³ów o sobie - doœwiadczenie, podejœcie do uczniów, hobby...">@Model.Opis</textarea>
                <small style="color: var(--kolor-tekst-szary); font-size: 13px;">
                    Max 500 znaków. Pojawi siê na Twoim publicznym profilu.
                </small>
            </div>
        }
 
        <div class="przyciski">
            <button type="submit" class="button">
                <i class="bi bi-check-circle"></i> Zapisz zmiany
            </button>
            <a asp-action="Profil" asp-route-id="@Model.Id" class="button-szary">Anuluj</a>
        </div>
    </form>
 
    @if (!User.IsInRole("Admin"))
    {
        <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--kolor-obramowanie);">
            <a asp-action="UsunKonto" class="button-czerwony" style="font-size: 14px; padding: 8px 16px;">
                <i class="bi bi-trash"></i> Usuñ konto
            </a>
        </div>
    }
</div>
