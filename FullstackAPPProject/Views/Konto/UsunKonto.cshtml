    ViewData["Title"] = "Usuń konto";
    var nazwaUzytkownika = User.Identity!.Name;
}
 
<div class="auth-karta" style="max-width: 520px;">
    <h1 style="color: var(--kolor-blad);"><i class="bi bi-exclamation-triangle"></i> Usuń konto</h1>
    <p class="auth-podtytul">
        Ta operacja jest <strong>nieodwracalna</strong>. Zostaną usunięte wszystkie Twoje dane:
        ogłoszenia, wiadomości, opinie i profil.
    </p>
 
    @if (ViewBag.Blad != null)
    {
        <div class="blad"><i class="bi bi-exclamation-triangle"></i> @ViewBag.Blad</div>
    }
 
    <form method="post" asp-action="UsunKonto" id="formUsunKonto">
        <div class="pole">
            <label><i class="bi bi-chat-left-text"></i> Dlaczego chcesz usunąć konto?</label>
            <textarea name="powod" rows="3" maxlength="500" required
                      placeholder="Np. Nie potrzebuję już korepetycji, znalazłem inną platformę..."></textarea>
            <small style="color: var(--kolor-tekst-szary); font-size: 13px;">
                Min. 5 znaków. Ta informacja pomoże nam ulepszać serwis.
            </small>
        </div>
 
        <div class="pole" style="margin-top: 20px; padding: 16px; background: var(--kolor-blad-tlo); border-radius: var(--zaokraglenie-male); border: 1px solid #fecaca;">
            <label style="color: var(--kolor-blad);">
                <i class="bi bi-shield-exclamation"></i> Aby potwierdzić, wpisz: <strong>USUN @nazwaUzytkownika</strong>
            </label>
            <input type="text" name="potwierdzenie" id="inputPotwierdzenie" required
                   placeholder="Wpisz tekst potwierdzający..."
                   autocomplete="off"
                   style="margin-top: 8px;" />
            <small style="color: var(--kolor-blad); font-size: 13px;">
                Musisz wpisać dokładnie: USUN @nazwaUzytkownika
            </small>
        </div>
 
        <div class="przyciski" style="flex-direction: column; margin-top: 20px;">
            <button type="submit" id="btnUsun" class="button-czerwony"
                    style="width: 100%; justify-content: center; opacity: 0.5; pointer-events: none;">
                <i class="bi bi-trash"></i> Tak, usuń moje konto na stałe
            </button>
            <a asp-action="Panel" class="button-szary" style="width: 100%; justify-content: center; text-align: center;">
                <i class="bi bi-arrow-left"></i> Nie, wracam do panelu
            </a>
        </div>
    </form>
</div>
 
<script>
   
    document.addEventListener('DOMContentLoaded', function () {
        var input = document.getElementById('inputPotwierdzenie');
        var btn = document.getElementById('btnUsun');
        var wymaganyTekst = 'USUN @nazwaUzytkownika';
 
        input.addEventListener('input', function () {
            if (input.value.trim() === wymaganyTekst) {
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
                input.style.borderColor = '#16a34a';
            } else {
                btn.style.opacity = '0.5';
                btn.style.pointerEvents = 'none';
                input.style.borderColor = '#dc2626';
            }
        });
 
        document.getElementById('formUsunKonto').addEventListener('submit', function (e) {
            if (input.value.trim() !== wymaganyTekst) {
                e.preventDefault();
                alert('Wpisz poprawny tekst potwierdzający!');
            }
        });
    });
</script>
