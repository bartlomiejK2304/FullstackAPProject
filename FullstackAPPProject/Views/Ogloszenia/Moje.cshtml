@model List<Ogloszenie>
@{
    ViewData["Title"] = "Moje ogłoszenia";
    var ikonyKategorii = new Dictionary<string, string>
    {
        { "Matematyka", "bi-calculator" },
        { "Fizyka", "bi-lightning-charge" },
        { "Język angielski", "bi-translate" },
        { "Język polski", "bi-book" },
        { "Informatyka", "bi-laptop" },
        { "Chemia", "bi-droplet-half" }
    };
}

<h1><i class="bi bi-collection"></i> Moje ogłoszenia</h1>

<p><a asp-action="Dodaj" class="button"><i class="bi bi-plus-circle"></i> Dodaj nowe</a></p>

@if (Model.Count == 0)
{
    <div class="info-pasek">
        <i class="bi bi-info-circle"></i>
        Nie masz jeszcze żadnych ogłoszeń. Dodaj pierwsze klikając przycisk powyżej.
    </div>
}
else
{
    <div class="lista">
        @foreach (var o in Model)
        {
            var ikona = ikonyKategorii.ContainsKey(o.Kategoria?.Nazwa ?? "")
                ? ikonyKategorii[o.Kategoria!.Nazwa]
                : "bi-book";

            <div class="karta">
                @if (!string.IsNullOrEmpty(o.ZdjeciePath))
                {
                    <img src="@o.ZdjeciePath" alt="@o.Tytul" class="karta-zdjecie" />
                }
                else
                {
                    <div class="karta-zdjecie-placeholder">
                        <i class="bi @ikona"></i>
                    </div>
                }
                <div class="karta-tresc">
                    <span class="karta-kategoria-tag">@o.Kategoria?.Nazwa</span>
                    <h3>
                        <a asp-action="Szczegoly" asp-route-id="@o.Id">@o.Tytul</a>
                    </h3>
                    <div class="karta-info"><i class="bi bi-geo-alt"></i> @o.Miasto</div>
                    <div class="karta-cena">@o.Cena zł / godz.</div>
                    <p class="data">Dodano: @o.DataDodania.ToString("dd.MM.yyyy")</p>

                    <div class="przyciski">
                        <a asp-action="Edytuj" asp-route-id="@o.Id" class="button">
                            <i class="bi bi-pencil"></i> Edytuj
                        </a>

                        <form asp-action="Usun" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@o.Id" />
                            <button type="submit" class="button-czerwony"
                                    onclick="return confirm('Na pewno usunąć?');">
                                <i class="bi bi-trash"></i> Usuń
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}