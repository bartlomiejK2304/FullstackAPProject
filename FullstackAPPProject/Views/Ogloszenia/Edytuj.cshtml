@model Ogloszenie
@{
    ViewData["Title"] = "Edytuj ogłoszenie";
}
 
<h1><i class="bi bi-pencil"></i> Edytuj ogłoszenie</h1>
 
<div class="formularz-karta">
    <form method="post" asp-action="Edytuj" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ZdjeciePath" />
 
        <div class="pole">
            <label asp-for="Tytul"></label>
            <input asp-for="Tytul" />
            <span asp-validation-for="Tytul" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Opis"></label>
            <textarea asp-for="Opis" rows="6" maxlength="2000"></textarea>
            <span asp-validation-for="Opis" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="KategoriaId"></label>
            <select asp-for="KategoriaId" asp-items="ViewBag.Kategorie"></select>
            <span asp-validation-for="KategoriaId" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Cena"></label>
            <input asp-for="Cena" type="number" step="0.01" />
            <span asp-validation-for="Cena" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Miasto"></label>
            <input asp-for="Miasto" />
            <span asp-validation-for="Miasto" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Forma"></label>
            <select asp-for="Forma">
                <option value="Online">Online</option>
                <option value="Stacjonarnie">Stacjonarnie</option>
            </select>
        </div>
 
        <div class="pole">
            <label><i class="bi bi-image"></i> Zdjęcie</label>
            @if (!string.IsNullOrEmpty(Model.ZdjeciePath))
            {
                <div style="margin-bottom: 8px;">
                    <img src="@Model.ZdjeciePath" alt="Aktualne zdjęcie"
                         style="max-width: 200px; border-radius: var(--zaokraglenie-male); border: 1px solid var(--kolor-obramowanie);" />
                </div>
            }
            <input type="file" name="zdjecie" accept="image/*" />
            <small style="color: var(--kolor-tekst-szary); font-size: 13px;">
                Wybierz nowy plik żeby zamienić zdjęcie. Zostaw puste żeby zostawić aktualne.
            </small>
        </div>
 
        <div class="przyciski">
            <button type="submit" class="button"><i class="bi bi-check-circle"></i> Zapisz zmiany</button>
            <a asp-action="Szczegoly" asp-route-id="@Model.Id" class="button-szary">Anuluj</a>
        </div>
    </form>
</div>
 
 
