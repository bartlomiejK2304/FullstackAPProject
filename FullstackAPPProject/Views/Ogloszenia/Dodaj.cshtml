@model Ogloszenie
@{
    ViewData["Title"] = "Dodaj og³oszenie";
}
 
<h1><i class="bi bi-plus-circle"></i> Dodaj nowe og³oszenie</h1>
 
<div class="formularz-karta">
    @* enctype="multipart/form-data" jest WYMAGANE ¿eby wys³aæ plik *@
    <form method="post" asp-action="Dodaj" enctype="multipart/form-data">
        <div class="pole">
            <label asp-for="Tytul"></label>
            <input asp-for="Tytul" placeholder="np. Korepetycje z matematyki - liceum" />
            <span asp-validation-for="Tytul" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Opis"></label>
            <textarea asp-for="Opis" rows="6" placeholder="Opisz swoje doœwiadczenie, metody pracy..."></textarea>
            <span asp-validation-for="Opis" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="KategoriaId"></label>
            <select asp-for="KategoriaId" asp-items="ViewBag.Kategorie">
                <option value="">-- wybierz --</option>
            </select>
            <span asp-validation-for="KategoriaId" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Cena"></label>
            <input asp-for="Cena" type="number" step="0.01" placeholder="80" />
            <span asp-validation-for="Cena" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Miasto"></label>
            <input asp-for="Miasto" placeholder="np. Warszawa" />
            <span asp-validation-for="Miasto" class="blad"></span>
        </div>
 
        <div class="pole">
            <label asp-for="Forma"></label>
            <select asp-for="Forma">
                <option value="Online">Online</option>
                <option value="Stacjonarnie">Stacjonarnie</option>
            </select>
        </div>

        @* ---- Pole na zdjêcie ---- *@
        <div class="pole">
            <label for="zdjecie"><i class="bi bi-image"></i> Zdjêcie (opcjonalne)</label>
            <input type="file" name="zdjecie" id="zdjecie" accept="image/*" />
            <small style="color: var(--kolor-tekst-szary); font-size: 13px;">
                Mo¿esz dodaæ zdjêcie, które pojawi siê przy og³oszeniu. Dozwolone: jpg, png.
            </small>
        </div>

        <div class="przyciski">
            <button type="submit" class="button"><i class="bi bi-check-circle"></i> Zapisz</button>
            <a asp-action="Index" class="button-szary">Anuluj</a>
        </div>
    </form>
</div>

